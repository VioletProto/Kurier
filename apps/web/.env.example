# Public configuration only; never put tokens/passwords in VITE_* values.
VITE_COGNITO_USER_POOL_ID=us-east-2_EXISTINGPOOL
VITE_COGNITO_CLIENT_ID=EXISTING_PUBLIC_CLIENT_ID
# Or https://DEPLOYED_ID.execute-api.us-east-2.amazonaws.com for dev-api.
VITE_API_URL=http://127.0.0.1:8080
VITE_KURIER_STAGE=local
# Broker development uses HTTPS and a loopback-only same-origin proxy.
# Set these in the process environment when running Vite (never commit keys).
# VITE_KURIER_SESSION_BROKER=true
# KURIER_LOCAL_HTTPS_CERT=/absolute/path/to/trusted-local-cert.pem
# KURIER_LOCAL_HTTPS_KEY=/absolute/path/to/private-local-key.pem
# KURIER_SESSION_PROXY_TARGET=http://127.0.0.1:8081
