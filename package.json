{
  "name": "kurier",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @kurier/web",
    "format": "prettier --write . && npm run format:go",
    "format:check": "prettier --check . && npm run format:check:go",
    "format:go": "gofmt -w services infra/spikes/sst-viability/service infra/spikes/sst-db-viability/service",
    "format:check:go": "test -z \"$(gofmt -l services infra/spikes/sst-viability/service infra/spikes/sst-db-viability/service)\"",
    "lint": "npm run lint --workspaces --if-present",
    "sst:deploy": "sst deploy --stage viability",
    "sst:diff": "sst diff --stage viability",
    "sst:install": "sst install --stage viability",
    "sst:remove": "sst remove --stage viability",
    "sst:state:list": "sst state list --stage viability",
    "sst:build-image:db": "infra/spikes/sst-db-viability/build-image.sh",
    "sst:deploy:db": "npm run sst:build-image:db && sst deploy --stage db-viability",
    "sst:diff:db": "npm run sst:build-image:db && sst diff --stage db-viability",
    "sst:install:db": "sst install --stage db-viability",
    "sst:remove:db": "sst remove --stage db-viability",
    "sst:state:list:db": "sst state list --stage db-viability",
    "test": "npm run test --workspaces --if-present && npm run test:infra",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build && npm run verify:go",
    "verify:go": "set -e; for service in services/api services/worker services/local-agent infra/spikes/sst-viability/service infra/spikes/sst-db-viability/service; do (cd \"$service\" && go test ./... && go vet ./...); done",
    "test:ownership:integration": "cd services/api && go test -race -tags=integration -count=1 ./...",
    "test:browser:integration": "cd services/api && go test -race -tags=integration,browser -run TestIntegrationBrowserProjects -count=1 ./internal/ownership",
    "sst:diff:auth": "node scripts/sst-auth.mjs diff",
    "sst:deploy:auth": "node scripts/sst-auth.mjs deploy",
    "dev:api": "node scripts/local-dev.mjs api",
    "dev:auth": "node scripts/local-dev.mjs web",
    "test:infra": "vitest run --config infra/vitest.config.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "sst": "4.17.1"
  },
  "engines": {
    "node": ">=22"
  }
}
