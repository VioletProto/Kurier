# Copy values into the process environment; Go does not auto-load this file.
# Public configuration and loopback-only local storage.
PORT=8080
KURIER_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
KURIER_CONTROL_TABLE=kurier-local-control
KURIER_STAGE=local
KURIER_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/EXISTING_POOL_ID
KURIER_COGNITO_CLIENT_ID=EXISTING_PUBLIC_CLIENT_ID
KURIER_FRONTEND_ORIGIN=http://localhost:5173
# Supply a private random >=32-byte base64 cursor key securely at runtime.
# The dev:api helper generates one in memory when omitted.
